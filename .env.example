# Copy to .env.local and fill in. `pnpm setup` does this for you and
# generates AUTH_SECRET.

# ─────────────────────────────────────────────────────────────────────────
# Core (required)
# ─────────────────────────────────────────────────────────────────────────

# Random 32-byte secret. Generate with: openssl rand -base64 32
# Signs session cookies, magic-link tokens, and approval-decision tokens.
AUTH_SECRET=

# Comma/space/semicolon separated admin emails. Admins can view, approve,
# reject and revoke. Set at least one or no one can administer.
ADMIN_EMAILS=you@example.com

# Canonical URL of your deployment. Most hosts set this automatically; set it
# explicitly for custom domains so links in emails point to the right place.
# AUTH_URL=https://docs.example.com

# ─────────────────────────────────────────────────────────────────────────
# Auth providers (enable any subset — each turns on when its vars are set)
# ─────────────────────────────────────────────────────────────────────────

# Google  → console.cloud.google.com → APIs & Services → Credentials
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# GitHub  → github.com/settings/developers → New OAuth App
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Microsoft Entra ID (Azure AD)
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0

# Generic OIDC (Okta, Auth0, Keycloak, Authentik, …)
# AUTH_OIDC_ID=
# AUTH_OIDC_SECRET=
# AUTH_OIDC_ISSUER=https://issuer.example.com
# AUTH_OIDC_NAME=SSO

# Email magic link is always available. It needs a mailer (below). With no
# mailer configured, links are printed to the server console (dev only).

# ─────────────────────────────────────────────────────────────────────────
# Mailer (used by magic links + approval emails). Picked in this order:
#   RESEND_API_KEY set → Resend · else EMAIL_SERVER_HOST set → SMTP · else console
# ─────────────────────────────────────────────────────────────────────────

# Resend (https://resend.com)
# RESEND_API_KEY=

# SMTP (any provider)
# EMAIL_SERVER_HOST=smtp.example.com
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER=
# EMAIL_SERVER_PASSWORD=

# From header for all outbound mail, e.g. "Acme Docs <docs@example.com>"
# EMAIL_FROM=

# ─────────────────────────────────────────────────────────────────────────
# Storage (viewers, pending requests, audit log). Magic-link tokens are
# stateless JWTs and need no storage.
#   "json"        → local JSON file (default; great for Docker/VPS/long-running)
#   "edge-config" → Vercel Edge Config (serverless on Vercel)
#   "redis"       → Upstash-compatible Redis over REST (any serverless, multi-instance)
# ─────────────────────────────────────────────────────────────────────────
STORAGE_DRIVER=json

# json driver: directory for the data file (default ./.data)
# DATA_DIR=./.data

# edge-config driver:
# EDGE_CONFIG=https://edge-config.vercel.com/ecfg_xxx?token=yyy
# VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=

# redis driver (Upstash or any Upstash-compatible REST endpoint):
# REDIS_REST_URL=https://your-db.upstash.io
# REDIS_REST_TOKEN=
# REDIS_KEY=keyring-docsend:access-state   # optional; this is the default
