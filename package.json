{
  "name": "keyring-docsend",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable, gated document sharing. An open-source DocSend alternative.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dupes": "jscpd",
    "verify": "pnpm typecheck && pnpm lint && pnpm dupes && pnpm test:coverage",
    "setup": "node scripts/setup.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "jose": "^6.2.3",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.31",
    "nodemailer": "^9.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.2.6",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-sonarjs": "^3.0.7",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jscpd": "^4.2.4",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  }
}
